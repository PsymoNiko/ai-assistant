{
  "name": "01 AI Gateway",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "parameters": {
        "path": "ai-gateway",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      }
    },
    {
      "id": "2",
      "name": "Set Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [360, 300],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "input",
              "value": "={{ $json[\"body\"] || $json }}"
            },
            {
              "name": "headers",
              "value": "={{ $json[\"headers\"] || {} }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "Planner",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [560, 300],
      "parameters": {
        "workflowName": "02 Planner",
        "dataPropertyName": "input"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Set Payload",
            "type": "main",
            "index": 0
          }
