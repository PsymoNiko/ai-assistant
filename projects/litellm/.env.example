# Example environment for LiteLLM
# Copy this file to `.env` and fill in secure values before running the stack.

# LiteLLM encryption keys (generate strong random values)
LITELLM_MASTER_KEY=REPLACE_WITH_STRONG_RANDOM_MASTER_KEY
LITELLM_SALT_KEY=REPLACE_WITH_STRONG_RANDOM_SALT_KEY

# Database URL for the LiteLLM service. The compose file expects a local `db` service by default.
DATABASE_URL=postgresql://litellm:litellm@db:5432/litellm

# Optional: set a runtime API key that other services (n8n, gateway) will use when talking to the LiteLLM API.
# Create a dedicated virtual key for each integration and keep them secret.
LITELLM_API_KEY="REPLACE_WITH_VIRTUAL_KEY"
